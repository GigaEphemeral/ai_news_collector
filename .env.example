# 复制为 .env(或直接用 /home/czq/ai_news/.env)并填入真实值;严禁提交真实值
# .env 需要 chmod 600
GITHUB_PAT=
# 飞书自定义机器人(秘密;严禁提交真实值/打印/写日志)
FEISHU_WEBHOOK_URL=
# 飞书机器人安全关键词(webhook 校验必需,发送文本必须包含;回退 config report.required_keyword)
FEISHU_WEBHOOK_KEYWORD=
# 可选(供复用原项目 rss_fetcher 定位其 src;默认自动探测 code/ai-news-brief/src)
# AI_NEWS_BRIEF_SRC=/path/to/ai-news-brief/src
